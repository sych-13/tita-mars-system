rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(userId) {
      return /databases/$(database)/documents/profiles/$(userId);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath(request.auth.uid));
    }

    function isOwner() {
      return hasProfile() &&
        get(profilePath(request.auth.uid)).data.role == 'owner' &&
        get(profilePath(request.auth.uid)).data.active == true;
    }

    function isStaff() {
      return hasProfile() &&
        get(profilePath(request.auth.uid)).data.active == true &&
        (get(profilePath(request.auth.uid)).data.role == 'owner' ||
         get(profilePath(request.auth.uid)).data.role == 'staff');
    }

    function isOwnOrder() {
      return signedIn() && resource.data.customerId == request.auth.uid;
    }

    function validStatusForOrder() {
      return (resource.data.orderType == 'delivery' &&
        request.resource.data.status in [
          'Pending', 'Confirmed', 'Preparing', 'Out for Delivery',
          'Completed', 'Cancelled'
        ]) ||
        (resource.data.orderType != 'delivery' &&
          request.resource.data.status in [
            'Pending', 'Confirmed', 'Preparing', 'Ready for Pickup',
            'Completed', 'Cancelled'
          ]);
    }

    function validStatusTransition() {
      return
        (resource.data.status == request.resource.data.status &&
          !(resource.data.status in ['Completed', 'Cancelled'])) ||
        (resource.data.status == 'Pending' &&
          request.resource.data.status in ['Confirmed', 'Cancelled']) ||
        (resource.data.status == 'Confirmed' &&
          request.resource.data.status in ['Preparing', 'Cancelled']) ||
        (resource.data.status == 'Preparing' &&
          request.resource.data.status in [
            'Ready for Pickup', 'Out for Delivery', 'Cancelled'
          ]) ||
        (resource.data.status in ['Ready for Pickup', 'Out for Delivery'] &&
          request.resource.data.status in ['Completed', 'Cancelled']);
    }

    function validInventoryMarker() {
      return
        (request.resource.data.status == 'Completed' &&
          resource.data.status != 'Completed' &&
          resource.data.inventoryDeductedAt == null &&
          request.resource.data.inventoryDeductedAt is string) ||
        (request.resource.data.status != 'Completed' &&
          request.resource.data.inventoryDeductedAt ==
            resource.data.inventoryDeductedAt);
    }

    function validNewOrder(orderId) {
      return request.resource.data.keys().hasOnly([
          'id', 'customerId', 'customer', 'phone', 'email', 'address',
          'deliveryArea', 'notes', 'orderType', 'payment', 'subtotal',
          'deliveryFee', 'total', 'items', 'number', 'status', 'createdAt',
          'updatedAt', 'inventoryDeductedAt'
        ]) &&
        request.resource.data.id == orderId &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.customer is string &&
        request.resource.data.customer.size() > 0 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.address is string &&
        request.resource.data.deliveryArea is string &&
        request.resource.data.notes is string &&
        request.resource.data.orderType in ['pickup', 'delivery'] &&
        request.resource.data.payment in ['cash', 'gcash'] &&
        request.resource.data.subtotal is number &&
        request.resource.data.deliveryFee is number &&
        request.resource.data.total is number &&
        request.resource.data.subtotal >= 0 &&
        request.resource.data.deliveryFee >= 0 &&
        request.resource.data.total ==
          request.resource.data.subtotal + request.resource.data.deliveryFee &&
        ((request.resource.data.orderType == 'pickup' &&
            request.resource.data.deliveryFee == 0 &&
            request.resource.data.deliveryArea == '') ||
          (request.resource.data.orderType == 'delivery' &&
            request.resource.data.deliveryArea in ['Taytay', 'Cainta'])) &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 50 &&
        request.resource.data.number is string &&
        request.resource.data.status == 'Pending' &&
        request.resource.data.createdAt is string &&
        request.resource.data.updatedAt is string &&
        request.resource.data.inventoryDeductedAt == null;
    }

    function validProduct(productId) {
      return request.resource.data.keys().hasOnly([
          'id', 'name', 'category', 'supplier', 'price', 'stock',
          'available', 'archived', 'image', 'description', 'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.id == productId &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.category in [
          'Tita Mars Eatery', "Ribbonette's Bakeshoppe", 'Gabbis Bakeshop'
        ] &&
        request.resource.data.supplier == request.resource.data.category &&
        request.resource.data.price is number &&
        request.resource.data.price >= 0 &&
        request.resource.data.stock is int &&
        request.resource.data.stock >= 0 &&
        request.resource.data.available is bool &&
        request.resource.data.archived is bool &&
        request.resource.data.image is string &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 600 &&
        request.resource.data.createdAt is string &&
        request.resource.data.updatedAt is string &&
        !(request.resource.data.stock == 0 &&
          request.resource.data.available == true) &&
        !(request.resource.data.archived == true &&
          request.resource.data.available == true);
    }

    function validStoreSettings() {
      return request.resource.data.keys().hasOnly([
          'name', 'phone', 'email', 'address', 'hours', 'deliveryFee',
          'gcashName', 'gcashNumber'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.phone is string &&
        request.resource.data.email is string &&
        request.resource.data.address is string &&
        request.resource.data.address.size() > 0 &&
        request.resource.data.hours is string &&
        request.resource.data.hours.size() > 0 &&
        request.resource.data.deliveryFee is int &&
        request.resource.data.deliveryFee >= 0 &&
        request.resource.data.gcashName is string &&
        request.resource.data.gcashNumber is string;
    }

    function validProfile() {
      return request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'address', 'role', 'active', 'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.phone is string &&
        request.resource.data.address is string &&
        request.resource.data.role in ['customer', 'staff', 'owner'] &&
        request.resource.data.active is bool &&
        request.resource.data.createdAt is string &&
        request.resource.data.updatedAt is string;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isOwner() && validProduct(productId);
      allow delete: if isOwner();
      allow update: if (isOwner() && validProduct(productId)) ||
        (isStaff() &&
          validProduct(productId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stock', 'available', 'updatedAt']) &&
          request.resource.data.stock is int &&
          request.resource.data.stock >= 0 &&
          request.resource.data.stock < resource.data.stock &&
          request.resource.data.available is bool &&
          request.resource.data.updatedAt is string &&
          ((request.resource.data.stock > 0 &&
            request.resource.data.available == resource.data.available) ||
           (request.resource.data.stock == 0 &&
            request.resource.data.available == false)));
    }

    match /profiles/{profileId} {
      allow read: if signedIn() && (request.auth.uid == profileId || isOwner());
      allow create: if (isOwner() &&
          validProfile() &&
          request.resource.data.role == 'staff' &&
          request.resource.data.active == true) ||
        (signedIn() &&
          validProfile() &&
          request.auth.uid == profileId &&
          request.resource.data.role == 'customer' &&
          request.resource.data.active == true);
      allow update: if (isOwner() &&
          validProfile() &&
          request.resource.data.role == resource.data.role) ||
        (signedIn() &&
          validProfile() &&
          request.auth.uid == profileId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.active == resource.data.active &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'email', 'phone', 'address', 'updatedAt']));
      allow delete: if isOwner();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && validNewOrder(orderId);
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isStaff());
      allow update: if
        (isStaff() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt', 'inventoryDeductedAt']) &&
          request.resource.data.updatedAt is string &&
          validStatusForOrder() &&
          validStatusTransition() &&
          validInventoryMarker()) ||
        (isOwnOrder() &&
          resource.data.status == 'Completed' &&
          !resource.data.keys().hasAny(['review']) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['review']) &&
          request.resource.data.review.rating is int &&
          request.resource.data.review.rating >= 1 &&
          request.resource.data.review.rating <= 5 &&
          request.resource.data.review.comment is string &&
          request.resource.data.review.comment.size() <= 600 &&
          request.resource.data.review.createdAt is string);
      allow delete: if isOwner();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwner() && settingId == 'store' && validStoreSettings();
    }
  }
}
